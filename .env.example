DATABASE_URL=postgres://postgres:postgres@localhost:5433/conexus

# Generate with: npx auth secret
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Build execution runs on Anthropic Managed Agents. Create the agent and
# environment once with: npx tsx scripts/setup-build-agent.ts
ANTHROPIC_BUILD_AGENT_ID=
ANTHROPIC_BUILD_ENVIRONMENT_ID=

# https://console.anthropic.com/settings/keys
# Without this, PRD/spec generation returns clearly-labelled stub content in
# development (and throws in production).
ANTHROPIC_API_KEY=

# https://resend.com/api-keys
# Also used to email the operator when a build run finishes. Without it, those
# emails are logged to the server console in development instead of being sent.
RESEND_API_KEY=
# Must be on a domain verified in Resend. For local dev you can use onboarding@resend.dev
RESEND_FROM_EMAIL=onboarding@resend.dev

# How often the server advances the build queue, in milliseconds. This is what
# lets a run finish with no browser tab open. Default 10000; set 0 to disable.
BUILD_QUEUE_TICK_MS=10000

# Only needed on serverless, where no process survives between requests and an
# external cron must drive the queue instead:
#   curl -X POST $URL/api/build-queue/tick -H "Authorization: Bearer $SECRET"
# Left unset, that endpoint is disabled rather than open.
BUILD_QUEUE_SECRET=
